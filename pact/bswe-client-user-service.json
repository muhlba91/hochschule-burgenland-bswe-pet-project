  "interactions": [
    {
      "comments": {
        "text": [

        ]
      },
      "description": "a request to list all users",
      "key": "6faf5dd1",
      "pending": false,
      "providerStates": [
        {
          "name": "a user with username johndoe exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/user/"
      },
      "response": {
        "body": {
          "content": {
            "users": [
              {
                "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "username": "johndoe"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.users": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.users[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.users[*].username": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
